{
  "name": "electron-vue-vite",
  "version": "3.0.0",
  "private": true,
  "description": "Vue 3 + TypeScript + Vite + Electron starter",
  "author": "ZJINH",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "npm run lint:oxlint && npm run lint:vue",
    "lint:oxlint": "oxlint --config .oxlintrc.json .",
    "lint:vue": "eslint \"src/**/*.vue\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build:web": "vite build --config vite.config.ts",
    "build": "npm run typecheck && npm run lint && electron-vite build && electron-builder",
    "preview": "vite preview --config vite.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "axios": "^1.21.1",
    "electron-updater": "^6.8.11",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.45",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "appId": "com.zjinh.app.test"
}
